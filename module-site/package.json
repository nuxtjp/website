{
  "name": "@nuxtjp/public-module-site",
  "version": "0.1.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": "10.29.3"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "typecheck": "nuxt typecheck",
    "generate": "nuxt generate",
    "test:site-structure": "node --test site/navigation.cases.mts && node site/check.mjs",
    "test": "pnpm run test:dependency-security && pnpm run test:site-structure && node --test site/experience.cases.mts",
    "test:dependency-security": "nuxtjp-security-check --project-root ."
  },
  "dependencies": {
    "@nuxtjp/contact-form": "0.1.0",
    "@nuxtjp/localized-site": "0.5.1",
    "nuxt": "4.6.2",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@nuxtjp/dependency-security": "0.2.0",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.13",
    "wrangler": "4.151.2"
  },
  "pnpm": {
    "overrides": {
      "simple-git": "4.0.2",
      "@simple-git/argv-parser": "2.0.1",
      "esbuild": "0.28.2",
      "undici@6": "6.29.1",
      "undici@7": "7.30.1",
      "undici@8": "8.12.2",
      "serialize-javascript@7": "7.1.3",
      "fast-uri@3": "3.1.9"
    },
    "patchedDependencies": {
      "braces@3.0.3": ".nuxtjp-security/braces-3.0.3.patch",
      "node-forge@1.4.0": ".nuxtjp-security/node-forge-1.4.0.patch"
    }
  }
}
